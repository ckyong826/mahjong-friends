{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mahjong-friends",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "MahjongRoom"
      }
    ]
  },
  "exports": {
    "MahjongRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
